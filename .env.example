# Google Gemini AI Key (For AI Shikshak & AI Mentor)
# Get free API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Hyperswitch (Juspay) Payment Orchestrator Configuration
# If you have an active Hyperswitch account, fill in your credentials below.
# If left as sandbox/test, the server automatically uses local smart-routing sandbox mode.

HYPERSWITCH_API_KEY=snd_test_your_secret_key_here
HYPERSWITCH_PUBLISHABLE_KEY=pk_snd_your_publishable_key_here
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io
HYPERSWITCH_WEBHOOK_SECRET=whsec_sample_secret_key

# Job Aggregation API (Adzuna)
# Get free Adzuna keys at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Port
PORT=5000

# Redis Distributed Caching & Rate Limiting
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka Event Streaming Configuration (Local, Cloud Confluent/Upstash/Aiven)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tech-indro-backend
KAFKA_GROUP_ID=tech-indro-consumers
# Optional SASL / SSL for Cloud Kafka:
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=your_username
# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
